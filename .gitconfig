[user]
	name = Max Prehl
	email = max.prehl@sapphirek12.com
[alias]
	co = checkout
	st = status
	br = branch
	ci = commit
        lp= log --pretty=format:'%C(yellow)%h %C(dim white)%ai %C(reset)%C(cyan)%an%C(auto)%d %Creset%s'
	d = !git --git-dir=$HOME/.dotfiles.git/ --work-tree=$HOME
	stats = !sh $HOME/.local/bin/git-stats
        pa = "!git add -u && git ci --amend --no-edit && git push --force-with-lease"
        ls = "!gls() { \
            for f in $(git ls-files \"${1:-.}\"); do \
                git --no-pager log -1 \
                    --pretty=format:'%C(cyan)%ai %C(dim white)%an %Creset' -- \"$f\"; \
                echo $f; \
            done | sort -r; \
        }; gls"

